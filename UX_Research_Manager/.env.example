# Flask application
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
# Local fallback is sqlite:///data/project.db when DATABASE_URL is not set
DATABASE_URL=
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=false

# AI provider
MISTRAL_API_KEY=replace-with-your-mistral-key

# Optional local CLI data override (UXRM.py)
DATA_DIR=data
